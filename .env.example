# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=uppdemos
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL_NAME=gemini-2.5-flash

# Model Armor Security Guardrails
MODEL_ARMOR_PROJECT_ID=uppdemos
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=it-helpdesk-armor
MODEL_ARMOR_STRICT_MODE=false

# Jira Server-Side Credentials (Cloud Run FastMCP Server)
JIRA_DOMAIN=your-jira-instance.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Google Cloud Agent Identity & Auth Manager (3-Legged OAuth)
AUTH_PROVIDER_NAME=jira-auth-provider
ATLASSIAN_OAUTH_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_OAUTH_CLIENT_SECRET=your-atlassian-client-secret

# Server & MCP Configuration
PORT=8080
HOST=0.0.0.0
